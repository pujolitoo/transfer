{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transfer",
  "version": "0.2.0",
  "identifier": "com.transfer.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Transfer",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "popup",
        "create": false,
        "url": "popup.html",
        "title": "File request",
        "width": 360,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "send",
        "create": false,
        "url": "send.html",
        "title": "Send with Transfer",
        "width": 380,
        "height": 440,
        "minWidth": 320,
        "minHeight": 300,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RkYxNDQxQzk5MzkzQUUKUldTdWs1UEpRUlQvMThyUlVzc0xjWmx5TUFvR1JNM0JPcFNVNTBTZ0NlSVVmRHc4OTlHNVRrcS8K",
      "endpoints": ["https://github.com/pujolitoo/transfer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "File transfer between friends",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
